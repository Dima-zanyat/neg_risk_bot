@echo off
REM ============================================================
REM  Запуск бота с автоматическим перезапуском при падении.
REM  Простой вариант без установки чего-либо дополнительного -
REM  запустите этот файл и сверните окно. Если процесс упадёт
REM  (исключение, обрыв сети и т.п.), скрипт перезапустит его
REM  через 10 секунд. Чтобы остановить бота - закройте это окно
REM  (или нажмите Ctrl+C и подтвердите).
REM
REM  Это не настоящая Windows-служба: если компьютер перезагрузится,
REM  бот сам не запустится обратно, пока вы не запустите этот файл
REM  снова (либо не положите ярлык на него в папку автозагрузки
REM  shell:startup). Для автозапуска при загрузке Windows и работы
REM  без залогиненного пользователя - см. scripts/install_service.ps1
REM  (вариант через NSSM, более надёжный).
REM ============================================================

cd /d "%~dp0\.."

:loop
echo [%date% %time%] Запуск бота...
venv\Scripts\python.exe -m uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000
echo [%date% %time%] Процесс завершился (код выхода %errorlevel%). Перезапуск через 10 секунд...
timeout /t 10 /nobreak
goto loop
