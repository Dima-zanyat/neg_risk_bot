# Скопируйте в .env и настройте под себя. У всех значений есть разумные
# умолчания - пустой .env (или вообще без него) уже запускает сбор
# данных и сканер. Для реальных сделок и Telegram-бота нужно заполнить
# секции ниже явно.

APP_NAME=polymarket_bot
LOG_LEVEL=INFO
# Файл лога с ротацией - важно для бота, который работает сутками без
# присмотра. Смотрите его, если бот "висит" или падал ночью.
LOG_FILE=./data/bot.log
LOG_FILE_MAX_BYTES=10000000
LOG_FILE_BACKUP_COUNT=5
# Если процесс зависнет целиком дольше N секунд - стеки всех потоков сами
# запишутся в data/bot_hang_dump.log (0 = выключить)
HANG_WATCHDOG_TIMEOUT_SECONDS=90

# SQLite по умолчанию (без настройки). Перейти на Postgres позже:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/polymarket
DATABASE_URL=sqlite+aiosqlite:///./data/polymarket.db

GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com

# --- Сборщик данных ---
RUN_COLLECTOR_IN_PROCESS=true
COLLECTOR_MARKET_LIMIT=50
COLLECTOR_INTERVAL_SECONDS=60
COLLECTOR_CONCURRENCY=15
COLLECTOR_MAX_ORDERBOOK_TOKENS_PER_CYCLE=600
COLLECTOR_ORDERBOOK_PHASE_TIMEOUT_SECONDS=90
COLLECTOR_ORDERBOOK_REQUEST_TIMEOUT_SECONDS=15
COLLECTOR_SNAPSHOT_RETENTION_HOURS=24
COLLECTOR_PRUNE_EVERY_N_CYCLES=60
COLLECTOR_CYCLE_TIMEOUT_SECONDS=180

# --- Сканер арбитража NegRisk ---
RUN_SCANNER_IN_PROCESS=true
NEGRISK_SCAN_SIZE=10
NEGRISK_SCAN_INTERVAL_SECONDS=30
NEGRISK_MIN_PROFIT_PCT=0.01
NEGRISK_FEE_BIPS_FALLBACK=0
NEGRISK_MAX_FEE_LOOKUPS_PER_CYCLE=20

# --- Telegram (управление ботом) ---
TELEGRAM_BOT_TOKEN=
# Ваш числовой Telegram ID (узнать: напишите боту @userinfobot).
# Можно несколько через запятую: 111111,222222
TELEGRAM_ADMIN_IDS=
RUN_TELEGRAM_BOT_IN_PROCESS=true

# --- Polygon / кошелёк (нужно только для реальных сделок) ---
POLYGON_RPC_URL=https://polygon-rpc.com
# Публичный RPC лимитирует запросы - для постоянной работы лучше свой
# (Alchemy/Infura/QuickNode, есть бесплатные тарифы) - вписать сюда.
POLYGON_RPC_TIMEOUT_SECONDS=10
WALLET_ADDRESS=
WALLET_PRIVATE_KEY=
# 0 = обычный EOA-кошелёк. Если логинились в Polymarket через email/
# соцсети - см. объяснение в README, скорее всего нужно не 0.
WALLET_SIGNATURE_TYPE=0
WALLET_FUNDER_ADDRESS=

# --- Капитал и риск-лимиты ---
STARTING_BANKROLL_USD=100
EXECUTION_TRADE_FRACTION=0.08
EXECUTION_DAILY_FRACTION=0.30
EXECUTION_MAX_NOTIONAL_PER_TRADE=100
EXECUTION_DAILY_NOTIONAL_CAP=300
EXECUTION_MAX_SLIPPAGE_PCT=0.02

# --- Исполнение сделок: ДВА независимых выключателя ---
# Пока хотя бы один из них false - сделки не совершаются, только лог и
# Telegram-уведомления о найденных возможностях.
ENABLE_ONCHAIN_EXECUTION=false
RUN_EXECUTOR_IN_PROCESS=false
EXECUTOR_POLL_INTERVAL_SECONDS=5
